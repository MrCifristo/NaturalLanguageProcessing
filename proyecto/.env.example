# Copiar a .env y completar. .env no se sube al repositorio.

# Resumen diario por correo (D-09). Con Resend: servidor smtp.resend.com, puerto 465,
# usuario «resend» y la API key como clave. El remitente tiene que ser de un dominio
# verificado en Resend (onboarding@resend.dev solo envía a la cuenta dueña de la key).
SMTP_SERVIDOR=smtp.resend.com
SMTP_PUERTO=465
SMTP_USUARIO=resend
SMTP_CLAVE_APP=
CORREO_REMITENTE=
# Uno o varios, separados por coma
CORREO_DESTINO=
