# Copiar a .env y completar. .env no se sube al repositorio.

# Resumen diario y alertas por correo (Fases 6 y 7, D-09).
# Con Gmail, SMTP_CLAVE_APP es una contraseña de aplicación, no la de la cuenta.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE_APP=
# Uno o varios, separados por coma
CORREO_DESTINO=
